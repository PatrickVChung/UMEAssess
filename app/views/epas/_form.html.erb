<%= form_with(model: @epa, class: "needs-validation", novalidate: true) do |f| %>
  <!-- Error Summary Notification -->
  <% if f.object.errors.any? %>
    <div class="alert alert-danger" role="alert">
      <h6 class="alert-heading fw-bold">Please correct the following errors:</h6>
      <ul class="mb-0">
        <% f.object.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Response ID -->
  <div class="row mb-3">
    <%= f.label :response_id, "Response ID", class: "col-sm-3 col-form-label text-end" %>
    <div class="col-sm-8">
      <%= f.text_field :response_id, class: "form-control" %>
    </div>
  </div>

  <!-- Student Assessed -->
  <div class="row mb-3">
    <%= f.label :student_assessed, "Student Assessed", class: "col-sm-3 col-form-label text-end" %>
    <div class="col-sm-8">
      <%= f.text_field :student_assessed, class: "form-control" %>
    </div>
  </div>

  <!-- Assessor Name -->
  <div class="row mb-3">
    <%= f.label :assessor_name, "Assessor Name", class: "col-sm-3 col-form-label text-end" %>
    <div class="col-sm-8">
      <%= f.text_field :assessor_name, class: "form-control" %>
    </div>
  </div>

  <!-- Assessor Email -->
  <div class="row mb-3">
    <%= f.label :assessor_email, "Assessor Email", class: "col-sm-3 col-form-label text-end" %>
    <div class="col-sm-8">
      <%= f.text_field :assessor_email, class: "form-control" %>
    </div>
  </div>

  <!-- EPA -->
  <div class="row mb-3">
    <%= f.label :epa, "EPA", class: "col-sm-3 col-form-label text-end" %>
    <div class="col-sm-8">
      <%= f.text_field :epa, class: "form-control" %>
    </div>
  </div>

  <!-- Involvement -->
  <div class="row mb-3">
    <%= f.label :involvement, "Involvement", class: "col-sm-3 col-form-label text-end" %>
    <div class="col-sm-8">
      <%= f.text_field :involvement, class: "form-control" %>
    </div>
  </div>

  <!-- Clinical Discipline -->
  <div class="row mb-3">
    <%= f.label :clinical_discipline, "Clinical Discipline", class: "col-sm-3 col-form-label text-end" %>
    <div class="col-sm-8">
      <%= f.text_field :clinical_discipline, class: "form-control" %>
    </div>
  </div>

  <!-- Clinical Setting -->
  <div class="row mb-3">
    <%= f.label :clinical_setting, "Clinical Setting", class: "col-sm-3 col-form-label text-end" %>
    <div class="col-sm-8">
      <%= f.text_field :clinical_setting, class: "form-control" %>
    </div>
  </div>

  <!-- Clinical Assessor -->
  <div class="row mb-3">
    <%= f.label :clinical_assessor, "Clinical Assessor", class: "col-sm-3 col-form-label text-end" %>
    <div class="col-sm-8">
      <%= f.text_field :clinical_assessor, class: "form-control" %>
    </div>
  </div>

  <!-- Submit Date -->
  <div class="row mb-3">
    <%= f.label :submit_date, "Submit Date", class: "col-sm-3 col-form-label text-end" %>
    <div class="col-sm-8">
      <%= f.date_field :submit_date, class: "form-control" %>
    </div>
  </div>

  <!-- Created At (Readonly Meta) -->
  <div class="row mb-3">
    <%= f.label :created_at, "Created At", class: "col-sm-3 col-form-label text-end" %>
    <div class="col-sm-8">
      <div class="form-control-plaintext"><%= f.object.created_at&.strftime("%Y-%m-%d %H:%M") || "—" %></div>
    </div>
  </div>

  <!-- Updated At (Readonly Meta) -->
  <div class="row mb-3">
    <%= f.label :updated_at, "Updated At", class: "col-sm-3 col-form-label text-end" %>
    <div class="col-sm-8">
      <div class="form-control-plaintext"><%= f.object.updated_at&.strftime("%Y-%m-%d %H:%M") || "—" %></div>
    </div>
  </div>

  <!-- Form Actions -->
  <div class="row mt-4">
    <div class="offset-sm-3 col-sm-8">
      <%= f.submit "Update WBA", class: "btn btn-primary px-4" %>
    </div>
  </div>
<% end %>

<%# app/views/shared/_modal.html.erb %>
<%# locals: title:, body:, size: nil, style: nil, create_tabs: false %>

<div class="modal fade"
     id="<%= local_assigns[:modal_id] || 'generic-modal' %>"
     tabindex="-1"
     aria-hidden="true"
     data-controller="modal draggable">

  <div class="modal-dialog <%= size %> modal-dialog-scrollable" style="<%= style %>">
    <div class="modal-content">
      <div class="modal-header"
           data-draggable-target="handle"
           data-action="mousedown->draggable#startDrag">

        <h5 class="modal-title"><%= title.html_safe %></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <% if local_assigns[:create_tabs] %>
        <%= render "epa_reviews/create_tabs", body: body %>
      <% else %>
        <div class="modal-body">
          <%= body %>
        </div>
      <% end %>
    </div>
  </div>
</div>

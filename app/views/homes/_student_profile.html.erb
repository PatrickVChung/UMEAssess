<div class="container py-4">
    <div class="row mb-2">
      <div class="col-12">
        <div class="card border-0 shadow-sm bg-primary-subtle text-black p-2 position-relative" style="border-radius: 15px;">
          <div class="position-absolute top-0 end-0 p-3 opacity-75" style="font-size: 1rem;">
                <i class="bi bi-clock-history me-1"></i>
                Last login: <%= user.last_sign_in_at&.strftime("%b %d %Y, %H:%M") || "First time!" %>
          </div>

          <div class="d-flex align-items-center mb-3">
            <div class="flex-shrink-0">
              <div class="rounded-circle bg-white text-primary d-flex align-items-center justify-content-center" style="width: 80px; height: 80px; font-size: 2rem; font-weight: bold;">
                <%= user.display_name.first %>
              </div>
            </div>
            <div class="flex-grow-1 ms-4">
              <h2 class="mb-0"><%= welcome_msg %> </h2>
              <p class="opacity-75 mb-0">Student UID: <%= user.sid %> | Current Cohort: <%= user.permission_group.title %></p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="row g-4">
      <div class="col-md-6">
        <div class="card h-100 shadow-sm">
          <div class="card-header bg-transparent border-0 pt-3">
            <h5 class="card-title text-muted"><i class="bi bi-person-badge me-2"></i>Personal Details</h5>
          </div>
          <div class="card-body">
            <ul class="list-group list-group-flush">
              <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                <span class="text-secondary">Full Name</span>
                <span class="fw-bold"><%= user.display_name %></span>
              </li>
              <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                <span class="text-secondary">Email</span>
                <span class="fw-bold"><%= user.email %></span>
              </li>

              <% if ['chungp', 'fruhwirt', 'dunnbri', 'schneibe', 'itot'].include? Current.user.username %>
                <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                  <span class="text-primary"> <%= link_to 'Student UID', update_loa_users_path(sid: user.sid), class: "nav-link blue-text", target: :_blank %></span>
                  <span class="fw-bold"><%= user.sid %></span>
                </li>
              <% else %>
              <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                <span class="text-secondary">Student UID</span>
                <span class="fw-bold"><%= user.sid %></span>
              </li>
              <% end %>

              <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                <span class="text-secondary">Current Cohort</span>
                <span class="fw-bold"><%= user.permission_group.title %></span>
              </li>
              <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                <span class="text-secondary">Previous Cohort</span>
                <% if user.prev_permission_group_id.nil? %>
                  <span class="fw-bold"></span>
                <% else %>
                  <span class="fw-bold"><%= PermissionGroup.find_by(id: user.prev_permission_group_id).title %></span>
                <% end %>
              </li>
              <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                <span claAhoss="text-secondary">Program Status</span>
                <span class="fw-bold"><%= user.spec_program %></span>
              </li>
              <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                <span class="text-secondary">Matriculated Date</span>
                <span class="fw-bold"><%= user.matriculated_date %></span>
              </li>
              <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                <span class="text-secondary">New Competency?</span>
                <span class="fw-bold"><%= user.new_competency ? 'Yes' : 'No' %></span>
              </li>

              <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                <span class="text-secondary">Specialties Interest</span>
                <span class="fw-bold"><%= user.career_interest.flatten %></span>
              </li>
              <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                <span class="text-secondary">Required Total # of WBAs (all levels)</span>
                <span class="fw-bold"><%= user.epas.count %> out of 100</span>
              </li>
              <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                <span class="text-secondary">Total # of Badges Awarded: </span>
                <span class="fw-bold"><%= user.epa_masters.where(status: 'Badge').count %> out of 11</span>
              </li>
              <li class="list-group-item d-flex justify-content-between align-items-center px-0">

                <span class="fw-bold">** For students who matriculated to medical school prior to 2019, please see Medical Student Handbook for your WBA graduation requirements!</span>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <div class="col-md-6">
        <div class="card h-100 shadow-sm">
          <div class="card-header bg-transparent border-0 pt-3">
            <h5 class="card-title text-muted"><i class="bi bi-rocket-takeoff me-2"></i>Quick Actions/View Datasets</h5>
          </div>
          <div class="card-body">

            <ul classs="list-group">
              <%= link_to '<i style="color:#31a34f;" class="bi bi-book fs-5"></i> Course Catalog'.html_safe, courses_path(), target: '_blank',
                  class: 'list-group-item list-group-item-action text-primary ' %>
             <%= link_to '<i class="bi bi-person fs-5" style="color:#E1191C"></i> OASIS Advising Meeting'.html_safe, meetings_path(student_id: user.uuid), target: "_blank",
                          class: 'list-group-item list-group-item-action text-primary' %>
             <%= link_to '<i class="bi bi-file-pdf fs-5" style="color:purple"></i> View Artifacts/Upload Documents'.html_safe,
                          artifacts_path(user_id: user.id),
                          data: { turbo: true },
                          class: 'list-group-item list-group-item-action text-primary',
                          target: "_blank"
                   %>

                   <div style="display: flex; align-items: center; gap: 8px;">
                     <%= icon "female-doctor-with-a-circle-mark-svgrepo-com", width: 48, height: 48 %>
                     <% if user.permission_group_id < 20 %>
                      <%= link_to 'Clinical Datasets', competencies_path(uuid: user.uuid), target: "_blank" %>
                    <% else %>
                      <%= link_to 'Clinical Datasets', new_competencies_path(uuid: user.uuid), target: "_blank" %>
                    <% end %>
                   </div>

                   <%= icon "Stethoscope--Streamline-Core-Gradient", width: 24, height: 24 %>
                   <strong class="text-primary">Foundation of Medicine Blocks</strong>
                   <ul classs="list-group">
                     <% fom_block_array = [] %>
                     <% hf_exists_in_FomExam(user.id).each do |block| %>
                       <% cohort = block["cohort"] %>
                       <% permission_group_id = block["permission_group_id"] %>
                       <% course_code = block["course_code"] %>

                       <% if !course_code.include? "DISABLED" %>
                         <% session[:attach_id] = -1 %>
                         <% hf_check_aes_key %>
                         <% fom_block_array.push course_code %>

                         <li class="list-group-item">
                           <div style="text-indent: 20px;">
                             <%= link_to("#{cohort}: #{course_code}".html_safe,
                                         display_fom_fom_exams_path(
                                           permission_group_id: AES.encrypt(permission_group_id.to_s, session[:aes_key]),
                                           course_code: AES.encrypt(course_code, session[:aes_key]),
                                           uuid: user.uuid
                                         ),
                                         method: :get,
                                         data: { turbo: true },
                                         target: '_blank',
                                         class: 'list-group-item list-group-item-action text-primary' ) %>
                            </div>
                          </li>

                       <% else %>
                         <li class="list-group-item disabled text-muted fw-bold">
                           <%= "#{cohort}:Foundation of Medicine: #{course_code}" %>
                         </li>
                       <% end %>
                     <% end %>
                    </ul>
            </ul>
            <% if Current.user.can_add_step1_exam? %>
               <ul class="fw-bold">
                <%= link_to '<i class="bi-solid bi-gear" style="color:#23A9BD"></i> Add USMLE/Step Exams'.html_safe, usmle_exams_path(user_id: user.id, full_name: user.full_name),
                target: '_blank', class: "nav-link text-primary" %>
               </ul>
            <% end %>
            <button class="btn btn-outline-secondary d-flex align-items-center justify-content-between">
              View Requirements <i class="bi bi-chevron-right"></i>
            </button>
            <hr>
            <strong>Quick Actions (<font color="purple">Scheduled Appointment(s)</font>)</strong>
            <% if event_schedules&.present? %>
              <%= render partial: "homes/appt_schedule", locals: { event_schedules: event_schedules } %>
            <% else %>
              <p class="text-muted">No Appointments Found! </p>
            <% end %>
          </div>
        </div>
      </div>

    </div>

</div>

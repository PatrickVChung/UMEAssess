<div class="container py-2">
    <div class="row mb-2">
      <div class="col-12">
        <div class="card border-0 shadow-sm bg-primary-subtle text-black p-2 position-relative" style="border-radius: 15px;">
          <div class="position-absolute top-0 end-0 p-3 opacity-75" style="font-size: 1rem;">
                <i class="bi bi-clock-history me-1"></i>
                Last login: <%= Current.user.last_sign_in_at&.strftime("%b %d %Y, %H:%M") || "First time!" %>
          </div>

          <div class="d-flex align-items-center mb-3">
            <div class="flex-shrink-0">
              <div class="rounded-circle bg-white text-primary d-flex align-items-center justify-content-center" style="width: 80px; height: 80px; font-size: 2rem; font-weight: bold;">
                <%= Current.user.display_name.first %>
              </div>
            </div>
            <div class="flex-grow-1 ms-4">
              <h2 class="mb-0">Welcome back, <%= Current.user.display_name %>!</h2>
              <p class="opacity-75 mb-0">With Dean Privileges</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="row g-4">
      <div class="col-md-6">
        <div class="card h-100 shadow-sm">
          <div class="card-header bg-transparent border-0 pt-3">
            <h5 class="card-title text-muted"><i class="bi bi-person-badge me-2"></i>Personal Details</h5>
          </div>
          <div class="card-body">
            <ul class="list-group list-group-flush">
              <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                <span class="text-secondary">Full Name</span>
                <span class="fw-bold"><%= Current.user.display_name %></span>
              </li>
              <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                <span class="text-secondary">Email</span>
                <span class="fw-bold"><%= Current.user.email %></span>
              </li>

              <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                <span class="text-secondary">Permission Group</span>
                <span class="fw-bold"><%= Current.user.permission_group.title %></span>
              </li>

              <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                <span class="text-secondary">Program Status</span>
                <span class="fw-bold"><%= Current.user.spec_program %></span>
              </li>

              <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                <span class="text-secondary">Email Notification</span>
                <span class="fw-bold"><%= Current.user.subscribed ? 'Yes' : 'No' %></span>
              </li>

              <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                <span class="text-secondary">Coaching Type</span>
                <span class="fw-bold"><%= Current.user.coaching_type ? Current.user.coaching_type : 'None' %></span>
              </li>

            </ul>
          </div>
        </div>
      </div>

      <div class="col-md-6">
        <div class="card h-100 shadow-sm">
          <div class="card-header bg-transparent border-0 pt-3">
            <h5 class="card-title text-muted"><i class="bi bi-rocket-takeoff me-2"></i>Quick Actions/View Datasets</h5>
          </div>
          <div class="card-body d-grid gap-2">
            <ul classs="list-group">
              <li>
                <%= link_to artifacts_path, data: { turbo: true }, target: "_blank", class: "list-group-item list-group-item-action d-flex align-items-center gap-2 px-1" do %>
                  <i style="color:purple;" class="bi bi-cloud-arrow-up fs-5"></i>
                  <span>View Artifacts / Upload Documents</span>
                <% end %>
              </li>

              <% if Current.user&.coaching_type.in?(%w[dean admin]) %>
                <li>
                  <%= link_to categories_path, data: { turbo: true }, target: "_blank", class: "list-group-item list-group-item-action d-flex align-items-center gap-2 px-1" do %>
                    <i style="color: #F26A8D;" class="bi bi-tags fs-5"></i>
                    <span>Category / SubCategory Maintenance</span>
                  <% end %>
                </li>
              <% end %>
              <% if Current.user&.can_process_fom? && Current.user&.coaching_type != 'student' %>
                <li class="nav-item dropdown">
                  <a class="nav-link dropdown-toggle d-inline-flex align-items-center gap-2 fw-medium px-1"
                     href="#"
                     id="fomExamsDropdown"
                     role="button"
                     data-bs-toggle="dropdown"
                     aria-expanded="false">
                    <i class="bi bi-file-earmark-arrow-up text-primary fs-5"></i>
                    <span>FoM Exams</span>
                  </a>

                  <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-3 py-2 mt-2" aria-labelledby="fomExamsDropdown" style="min-width: 250px;">
                    <!-- Section: Processing & Automation -->
                    <li><h6 class="dropdown-header text-uppercase fs-7 text-muted tracking-wide">Processing</h6></li>

                    <li>
                      <%= link_to process_fom_fom_exams_path(uuid: Current.user.uuid), target: "_blank", class: "dropdown-item d-flex align-items-center gap-2 py-2" do %>
                        <i class="bi bi-cpu text-primary"></i>
                        <span>Process FoM</span>
                      <% end %>
                    </li>

                    <li>
                      <%= link_to send_alerts_fom_exams_path, data: { turbo_method: :post, turbo_confirm: "Are you sure you want to send out alerts?" }, class: "dropdown-item d-flex align-items-center gap-2 py-2" do %>
                        <i class="bi bi-bell-fill text-warning"></i>
                        <span>Send out Alerts</span>
                      <% end %>
                    </li>

                    <li><hr class="dropdown-divider my-1"></li>

                    <!-- Section: Documents & PDFs -->
                    <li><h6 class="dropdown-header text-uppercase fs-7 text-muted tracking-wide mt-1">Artifacts & Feedback</h6></li>

                    <li>
                      <%= link_to create_and_move_pdf_create_pdfs_path, target: "_blank", class: "dropdown-item d-flex align-items-center gap-2 py-2" do %>
                        <i class="bi bi-file-earmark-pdf text-info"></i>
                        <span>Create Informatics Q-PDF</span>
                      <% end %>
                    </li>

                    <li>
                      <%= link_to bulk_remove_artifacts_path, target: "_blank", data: { turbo_confirm: "Are you sure you want to bulk delete all PDFs?" }, class: "dropdown-item d-flex align-items-center text-danger gap-2 py-2" do %>
                        <i class="bi bi-trash3 text-danger"></i>
                        <span>Bulk Delete PDFs</span>
                      <% end %>
                    </li>

                  </ul>
                </li>
              <% end %>
                  <% if Current.user&.coaching_type.in?(%w[admin dean]) && Current.user.spec_program != 'Wellness' %>
                    <li class="nav-item dropdown">
                      <a class="nav-link dropdown-toggle d-inline-flex align-items-center gap-2 fw-medium px-1"
                         href="#"
                         id="egReviewDropdown"
                         role="button"
                         data-bs-toggle="dropdown"
                         aria-expanded="false">
                        <i style="color: #40B6B0;" class="bi bi-hospital-fill text-primaryfs-5"></i>
                        <span>EG Review</span>
                      </a>

                      <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-3 py-2 mt-2" aria-labelledby="egReviewDropdown" style="min-width: 260px;">
                        <!-- Section: Main Dashboard -->
                        <li>
                          <%= link_to epa_masters_path, class: "dropdown-item d-flex align-items-center gap-2 py-2 fw-semibold text-primary", target: "_blank" do %>
                            <i class="bi bi-speedometer2"></i>
                            <span>EG-Review Dashboard</span>
                          <% end %>
                        </li>

                        <li><hr class="dropdown-divider my-1"></li>

                        <!-- Header: Reports -->
                        <li><h6 class="dropdown-header text-uppercase fs-7 text-muted tracking-wide mt-1">Reports</h6></li>

                        <li>
                          <%= link_to eg_mismatch_epa_masters_path(file_name: "eg_mismatch.txt"), target: "_blank", class: "dropdown-item d-flex align-items-center gap-2 py-2" do %>
                            <i class="bi bi-exclamation-triangle text-warning"></i>
                            <span>EG-Mismatch Report</span>
                          <% end %>
                        </li>

                        <li>
                          <%= link_to eg_badged_epa_masters_path, target: "_blank", class: "dropdown-item d-flex align-items-center gap-2 py-2" do %>
                            <i class="bi bi-award text-success"></i>
                            <span>EG-Badged Report</span>
                          <% end %>
                        </li>

                        <li>
                          <%= link_to epa_qa_epa_masters_path, target: "_blank", class: "dropdown-item d-flex align-items-center gap-2 py-2" do %>
                            <i class="bi bi-patch-question text-info"></i>
                            <span>EPA-Q/A Report</span>
                          <% end %>
                        </li>

                        <li>
                          <%= link_to wba_epa_epa_masters_path, target: "_blank", class: "dropdown-item d-flex align-items-center gap-2 py-2" do %>
                            <i class="bi bi-file-earmark-text text-secondary"></i>
                            <span>WBA/EPA Report</span>
                          <% end %>
                        </li>

                        <li>
                          <%= link_to competency_rpt_new_competencies_path, target: "_blank", class: "dropdown-item d-flex align-items-center gap-2 py-2" do %>
                            <i class="bi bi-journal-check text-secondary"></i>
                            <span>Competency Report</span>
                          <% end %>
                        </li>

                        <li>
                          <%= link_to average_wba_epa_epa_masters_path, target: "_blank", class: "dropdown-item d-flex align-items-center gap-2 py-2" do %>
                            <i class="bi bi-calendar-range text-secondary"></i>
                            <span>Average WBA/EPA By Dates</span>
                          <% end %>
                        </li>

                        <li>
                          <%= link_to wba_clinical_epa_masters_path, target: "_blank", class: "dropdown-item d-flex align-items-center gap-2 py-2" do %>
                            <i class="bi bi-person-badge text-secondary"></i>
                            <span>WBA/Clinical Assessor</span>
                          <% end %>
                        </li>

                        <li><hr class="dropdown-divider my-1"></li>

                        <!-- Header: Visualizations -->
                        <li><h6 class="dropdown-header text-uppercase fs-7 text-muted tracking-wide mt-1">Analytics</h6></li>

                        <li>
                          <%= link_to badged_graph_epa_masters_path, target: "_blank", class: "dropdown-item d-flex align-items-center gap-2 py-2" do %>
                            <i class="bi bi-bar-chart-line text-indigo"></i>
                            <span>Badges by EPA Graph</span>
                          <% end %>
                        </li>

                        <li>
                          <%= link_to wba_epa_graph_epa_masters_path, target: "_blank", class: "dropdown-item d-flex align-items-center gap-2 py-2" do %>
                            <i class="bi bi-graph-up text-indigo"></i>
                            <span>WBAs by EPA Graph</span>
                          <% end %>
                        </li>
                      </ul>
                    </li>
                  <% end %>

                  <% if Current.user&.can_process_eg_assignment? || Current.user&.coaching_type == 'admin' %>
                    <li class="nav-item dropdown">
                      <a class="nav-link dropdown-toggle d-inline-flex align-items-center gap-2 fw-medium px-1"
                         href="#"
                         id="egMaintenanceDropdown"
                         role="button"
                         data-bs-toggle="dropdown"
                         aria-expanded="false">
                        <i class="bi bi-tools text-danger fs-5"></i>
                        <span>EG Maintenance</span>
                      </a>

                      <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-3 py-2 mt-2" aria-labelledby="egMaintenanceDropdown" style="min-width: 240px;">
                        <!-- Member Management -->
                        <li>
                          <%= link_to eg_members_path, target: "_blank", class: "dropdown-item d-flex align-items-center gap-2 py-2" do %>
                            <i class="bi bi-people text-secondary"></i>
                            <span>EG Members</span>
                          <% end %>
                        </li>

                        <li>
                          <%= link_to fix_eg_members_path, target: "_blank", class: "dropdown-item d-flex align-items-center gap-2 py-2" do %>
                            <i class="bi bi-person-gear text-warning"></i>
                            <span>Fix EG Members</span>
                          <% end %>
                        </li>

                        <li>
                          <%= link_to eg_assignment_fix_eg_members_path, target: "_blank", class: "dropdown-item d-flex align-items-center gap-2 py-2" do %>
                            <i class="bi bi-card-checklist text-primary"></i>
                            <span>List EG Assignment</span>
                          <% end %>
                        </li>

                        <li><hr class="dropdown-divider my-1"></li>

                        <!-- Configuration / System Settings -->
                        <li>
                          <%= link_to badging_dates_path, target: "_blank", class: "dropdown-item d-flex align-items-center gap-2 py-2" do %>
                            <i class="bi bi-calendar-check text-success"></i>
                            <span>Badging Dates</span>
                          <% end %>
                        </li>
                      </ul>
                    </li>
                  <% end %>

                  <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle d-inline-flex align-items-center gap-2 fw-medium px-1"
                       href="#"
                       id="oasisDropdown"
                       role="button"
                       data-bs-toggle="dropdown"
                       aria-expanded="false">
                      <i class="bi bi-calendar-event text-danger fs-5"></i>
                      <span>OASIS</span>
                    </a>

                    <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-3 py-2 mt-2" aria-labelledby="oasisDropdown" style="min-width: 260px;">
                      <!-- Main Direct Action -->
                      <li>
                        <%= link_to meetings_path, target: "_blank", class: "dropdown-item d-flex align-items-center gap-2 py-2 fw-semibold text-primary" do %>
                          <i class="bi bi-person-workspace fs-5"></i>
                          <span>OASIS Advising Meeting</span>
                        <% end %>
                      </li>

                      <% if Current.user&.coaching_type.in?(%w[admin dean]) %>
                        <li><hr class="dropdown-divider my-1"></li>

                        <!-- Reporting Section -->
                        <li><h6 class="dropdown-header text-uppercase fs-7 text-muted tracking-wide mt-1">Reporting & Listings</h6></li>

                        <li>
                          <%= link_to events_path, target: "_blank", class: "dropdown-item d-flex align-items-center gap-2 py-2" do %>
                            <i class="bi bi-calendar-week text-purple"></i>
                            <span>Future Appointments</span>
                          <% end %>
                        </li>

                        <li>
                          <%= link_to meeting_reports_path, target: "_blank", class: "dropdown-item d-flex align-items-center gap-2 py-2" do %>
                            <i class="bi bi-file-earmark-bar-graph text-purple"></i>
                            <span>Meeting Report</span>
                          <% end %>
                        </li>

                        <li><hr class="dropdown-divider my-1"></li>

                        <!-- Maintenance Section -->
                        <li><h6 class="dropdown-header text-uppercase fs-7 text-muted tracking-wide mt-1">Maintenance</h6></li>

                        <li>
                          <%= link_to advisors_path, target: "_blank", class: "dropdown-item d-flex align-items-center gap-2 py-2" do %>
                            <i class="bi bi-person-badge text-danger"></i>
                            <span>Advisors</span>
                          <% end %>
                        </li>

                        <li>
                          <%= link_to create_batch_appointments_events_path, target: "_blank", class: "dropdown-item d-flex align-items-center gap-2 py-2" do %>
                            <i class="bi bi-calendar-plus text-success"></i>
                            <span>Create Available Appointments</span>
                          <% end %>
                        </li>

                        <li>
                          <%= link_to advisors_path, target: "_blank", class: "dropdown-item d-flex align-items-center gap-2 py-2" do %>
                            <i class="bi bi-shuffle text-warning"></i>
                            <span>Create Random Appointments</span>
                          <% end %>
                        </li>
                      <% end %>
                    </ul>
                  </li>
              <li>
                <% if ["dean", "admin"].include? Current.user.coaching_type %>
                  <%= link_to '<i style="color:#31a34f;" class="bi bi-book fs-5"></i> Course Catalog'.html_safe, courses_path(), target: '_blank',
                      class: "list-group-item list-group-item-action d-flex align-items-center gap-2 px-1" %>
                <% end %>
              </li>
              Medhub <br>
              Report <br>
              WBA Graph/Report <br>
            </ul>
          </div>
        </div>
      </div>
    </div>

  <!-- Lower Section -->
  <div class="row g-3">
    <div class="col-lg-6">
      <div class="card shadow-sm border-0">
        <div class="card-header bg-white">
          <strong>Recent Activity (<font color="purple">Past 2 Weeks Appointment(s)</font>)</strong>
        </div>
        <div class="card-body">
          <% if events.present? %>
            <%= render partial: "homes/past_appts", locals: { events: events } %>
          <% else %>
            <p class="text-muted">No recent activity yet.</p>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-lg-6">
      <div class="card shadow-sm border-0">
        <div class="card-header bg-white">
          <strong>Quick Actions (<font color="purple">Scheduled Appointment(s)</font>)</strong>
        </div>
        <div class="card-body">
          <div class="d-grid gap-2">
            <% if event_schedules.present? %>
              <%= render partial: "homes/appt_schedule", locals: { event_schedules: event_schedules } %>
            <% else %>
              <p class="text-muted">No Appointments Found! </p>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

</div>

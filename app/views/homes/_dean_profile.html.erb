<div class="container py-2">
    <div class="row mb-2">
      <div class="col-12">
        <div class="card border-0 shadow-sm bg-primary-subtle text-black p-2 position-relative" style="border-radius: 15px;">
          <div class="position-absolute top-0 end-0 p-3 opacity-75" style="font-size: 1rem;">
                <i class="bi bi-clock-history me-1"></i>
                Last login: <%= Current.user.last_sign_in_at&.strftime("%b %d %Y, %H:%M") || "First time!" %>
          </div>

          <div class="d-flex align-items-center mb-3">
            <div class="flex-shrink-0">
              <div class="rounded-circle bg-white text-primary d-flex align-items-center justify-content-center" style="width: 80px; height: 80px; font-size: 2rem; font-weight: bold;">
                <%= Current.user.display_name.first %>
              </div>
            </div>
            <div class="flex-grow-1 ms-4">
              <h2 class="mb-0">Welcome back, <%= Current.user.display_name %>!</h2>
              <p class="opacity-75 mb-0">With Dean Privileges</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="row g-4">
      <div class="col-md-6">
        <div class="card h-100 shadow-sm">
          <div class="card-header bg-transparent border-0 pt-3">
            <h5 class="card-title text-muted"><i class="bi bi-person-badge me-2"></i>Personal Details</h5>
          </div>
          <div class="card-body">
            <ul class="list-group list-group-flush">
              <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                <span class="text-secondary">Full Name</span>
                <span class="fw-bold"><%= Current.user.display_name %></span>
              </li>
              <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                <span class="text-secondary">Email</span>
                <span class="fw-bold"><%= Current.user.email %></span>
              </li>

              <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                <span class="text-secondary">Permission Group</span>
                <span class="fw-bold"><%= Current.user.permission_group.title %></span>
              </li>

              <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                <span class="text-secondary">Program Status</span>
                <span class="fw-bold"><%= Current.user.spec_program %></span>
              </li>

              <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                <span class="text-secondary">Email Notification</span>
                <span class="fw-bold"><%= Current.user.subscribed ? 'Yes' : 'No' %></span>
              </li>

            </ul>
          </div>
        </div>
      </div>

      <div class="col-md-6">
        <div class="card h-100 shadow-sm">
          <div class="card-header bg-transparent border-0 pt-3">
            <h5 class="card-title text-muted"><i class="bi bi-rocket-takeoff me-2"></i>Quick Actions/View Datasets</h5>
          </div>
          <div class="card-body d-grid gap-2">
            <ul classs="list-group">
              <%= link_to 'View Artifacts/Upload Documents', artifacts_path, data: { turbo: true }, target: "_blank",
                  class: 'list-group-item list-group-item-action text-primary' %>

              <% if ["dean", "admin"].include?Current.user.coaching_type %>
                <%= link_to 'Category/SubCategory Maintenance', categories_path, data: {turbo: true}, target: "_blank",
                    class: 'list-group-item list-group-item-action text-primary' %>
              <% end %>

                  <% if Current.user.can_process_fom? and Current.user.coaching_type != 'student'%>
                  <strong>Process FoM Exams File </strong>
                    <ul classs="list-group">
                      <li><%= link_to 'Process FoM', process_fom_fom_exams_path(uuid: Current.user.uuid), target: '_blank',
                              class: 'list-group-item list-group-item-action text-primary' %></li>
                      <li><%= link_to 'Send out Alerts', send_alerts_fom_exams_path(), method: 'post',
                              class: 'list-group-item list-group-item-action text-primary', target: :_blank %></li>
                      <li><%= link_to 'Bulk Delete PDFs', bulk_remove_artifacts_path, target: '_blank',
                              class: 'list-group-item list-group-item-action text-primary' %></li>
                      <li><%= link_to 'Create Informatics Feedback (Q-PDF)', create_and_move_pdf_create_pdfs_path, target: '_blank',
                              class: 'list-group-item list-group-item-action text-primary' %></li>

                    </ul>
                  <% end %>
                  <% if Current.user &&
                        ['admin', 'dean'].include?(Current.user.coaching_type) &&
                        Current.user.spec_program != 'Wellness' %>

                    <class="nav-item dropdown">
                      <a class="nav-link dropdown-toggle"
                         href="#"
                         id="egReviewDropdown"
                         role="button"
                         data-bs-toggle="dropdown"
                         aria-expanded="false">
                        <i class="bi bi-hospital" style="color:blue"></i> EG Review
                      </a>
                      <ul class="dropdown-menu" aria-labelledby="egReviewDropdown">
                        <li><%= link_to 'EG-Review', epa_masters_path, class: "dropdown-item", target: "_blank" %></li>
                        <li><%= link_to 'EG-Mismatch Report', eg_mismatch_epa_masters_path(file_name: "eg_mismatch.txt"), target: "_blank", class: "dropdown-item" %></li>
                        <li><%= link_to 'EG-Badged Report', eg_badged_epa_masters_path, target: "_blank", class: "dropdown-item" %></li>
                        <li><%= link_to 'EPA-Q/A Report', epa_qa_epa_masters_path, target: "_blank", class: "dropdown-item" %></li>
                        <li><%= link_to 'WBA/EPA Report', wba_epa_epa_masters_path, target: "_blank", class: "dropdown-item" %></li>
                        <li><%= link_to 'Competency Report', competency_rpt_new_competencies_path, target: "_blank", class: "dropdown-item" %></li>
                        <li><%= link_to 'Average WBA/EPA By Dates Report', average_wba_epa_epa_masters_path, target: "_blank", class: "dropdown-item" %></li>
                        <li><%= link_to 'WBA/Clinical Assessor Report', wba_clinical_epa_masters_path, target: "_blank", class: "dropdown-item" %></li>
                        <li><%= link_to 'No of Badges by EPA Graph', badged_graph_epa_masters_path, target: "_blank", class: "dropdown-item" %></li>
                        <li><%= link_to 'No of WBAs by EPA Graph', wba_epa_graph_epa_masters_path, target: "_blank", class: "dropdown-item" %></li>
                      </ul>
                  <% end %>

                    <% if Current.user.can_process_eg_assignment? || Current.user.coaching_type == 'admin' %>
                    <class="nav-item dropdown">
                      <a class="nav-link dropdown-toggle"
                         href="#"
                         id="egMaintenanceDropdown"
                         role="button"
                         data-bs-toggle="dropdown"
                         aria-expanded="false">
                        <i class="bi bi-wrench" style="color:#E1191C"></i> EG Maintenance
                      </a>
                    <ul class="dropdown-menu" aria-labelledby="egMaintenanceDropdown">
                      <%= link_to '<i class="bi bi-wrench" style="color:#E1191C"></i> EG Members'.html_safe, eg_members_path, target: "_blank", class: "dropdown-item" %>
                      <%= link_to '<i class="bi bi-wrench" style="color:#E1191C"></i> Fix EG Members'.html_safe, fix_eg_members_path, target: "_blank", class: "dropdown-item" %>
                      <%= link_to '<i class="bi bi-wrench" style="color:#E1191C"></i> List EG Assignment'.html_safe, eg_assignment_fix_eg_members_path, target: "_blank", class: "dropdown-item" %>
                      <%= link_to '<i class="bi bi-wrench" style="color:#E1191C"></i> Badging Dates'.html_safe, badging_dates_path, target: "_blank", class: "dropdown-item" %>
                    </ul>
                  <% end %>

                  <%= link_to '<i class="bi bi-person" style="color:#E1191C"></i> OASIS Advising Meeting'.html_safe, meetings_path, target: "_blank" %>

                  <% if ['admin', 'dean'].include?(Current.user.coaching_type)  %>
                    <class="nav-item dropdown">
                      <a class="nav-link dropdown-toggle"
                         href="#"
                         id="OasisReportingDropdown"
                         role="button"
                         data-bs-toggle="dropdown"
                         aria-expanded="false">
                        <i class="bi bi-file-bar-graph" style="color:purple"></i> Oasis Reporting/Listing
                      </a>
                      <ul class="dropdown-menu" aria-labelledby="OasisReportingDropdown">
                          <%= link_to '<i class="bi bi-calendar" style="color:purple"></i> Future Appointments'.html_safe, events_path, target: "_blank", class: "dropdown-item" %>
                          <%= link_to '<i class="bi bi-calendar" style="color:purple"></i> Meeting Report'.html_safe, meeting_reports_path, target: "_blank", class: "dropdown-item" %>

                      </ul>
                  <% end %>

                  <% if ['admin', 'dean'].include?(Current.user.coaching_type)  %>
                    <class="nav-item dropdown">
                      <a class="nav-link dropdown-toggle"
                         href="#"
                         id="OasisMaintenanceDropdown"
                         role="button"
                         data-bs-toggle="dropdown"
                         aria-expanded="false">
                        <i class="bi bi-calendar" style="color:green"></i> Oasis Maintenance
                      </a>
                  <ul class="dropdown-menu" aria-labelledby="egMaintenanceDropdown">
                      <%= link_to '<i class="bi bi-person" style="color:#E1191C"></i> Advisors'.html_safe, advisors_path, target: "_blank", class: "dropdown-item" %>
                      <%= link_to '<i class="bi bi-calendar" style="color:#E1191C"></i> Create Available Appointments'.html_safe,
                            create_batch_appointments_events_path,
                            target: "_blank", class: "dropdown-item" %>

                      <%= link_to '<i class="bi bi-calendar" style="color:#E1191C"></i> Create Random Appointments'.html_safe, advisors_path, target: "_blank", class: "dropdown-item" %>

                  </ul>
                <% end %>
              Medhub <br>
              <% if ["dean", "admin"].include? Current.user.coaching_type %>
                <%= link_to '<i style="color:#31a34f;" class="bi bi-book"></i> Course Catalog'.html_safe, courses_path(), target: '_blank',
                    class: 'list-group-item list-group-item-action text-primary' %>
              <% end %>
              Report <br>
              WBA Graph/Report <br>
            </ul>
          </div>
        </div>
      </div>
    </div>

  <!-- Lower Section -->
  <div class="row g-3">
    <div class="col-lg-6">
      <div class="card shadow-sm border-0">
        <div class="card-header bg-white">
          <strong>Recent Activity (<font color="purple">Past 2 Weeks Appointment(s)</font>)</strong>
        </div>
        <div class="card-body">
          <% if events.present? %>
            <%= render partial: "homes/past_appts", locals: { events: events } %>
          <% else %>
            <p class="text-muted">No recent activity yet.</p>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-lg-6">
      <div class="card shadow-sm border-0">
        <div class="card-header bg-white">
          <strong>Quick Actions (<font color="purple">Scheduled Appointment(s)</font>)</strong>
        </div>
        <div class="card-body">
          <div class="d-grid gap-2">
            <% if event_schedules.present? %>
              <%= render partial: "homes/appt_schedule", locals: { event_schedules: event_schedules } %>
            <% else %>
              <p class="text-muted">No Appointments Found! </p>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

</div>

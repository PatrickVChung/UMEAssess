<!-- <p>HOME INDEX LOADED</p>
<%#= "current user: #{Current.user&.full_name} " %> -->

<% if Current.user&.coaching_type == "dean" %>
  <%= render partial: "dean_profile",
             locals: {
               events: @events,
               event_schedules: @event_schedules
             } %>
<% elsif Current.user&.coaching_type == "student" %>
  <%= render partial: "student_profile",
             locals: {
               welcome_msg: "Welcome back, #{Current.user.display_name}!",
               user: Current.user,
               event_schedules: @event_schedules
             } %>
<% else %>
  <% user_email = params[:search] %>
  <% event_schedules = hf_get_events_email(user_email) %>
  <%= render partial: "student_profile",
             locals: {
               event_schedules: event_schedules
             } %>
  <!-- Optional: public landing content -->
<% end %>

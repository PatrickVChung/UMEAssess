<% if !@eg_cohorts.nil? %>
    <br />
    <h5>EG Assignment -Click here to Download
    <%= link_to ('<i class="bi bi-download"></i>').html_safe, download_file_fix_eg_members_path(file_name: @eg_assignment_filename) %></h5>
    <div data-controller="datatable">
      <table data-datatable-target="table" class="table table-striped">
        <thead>
          <% @eg_cohorts.first.keys.each do |header| %>
            <th><%= header.titleize %></th>
          <% end %>
        </thead>
        <% @eg_cohorts.each do |data| %>
          <tr>
            <% data.each do |key, val| %>
              <td> <%= val %> </td>
            <% end %>
          </tr>
        <% end %>
      </table>
    </div>

<% end %>

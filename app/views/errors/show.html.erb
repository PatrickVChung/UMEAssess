<div class="container my-5 py-5 text-center">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="card shadow-sm p-4 border-danger">
        <div class="card-body">
          <h1 class="display-4 text-danger fw-bold"><%= @status_code %></h1>

          <% if @status_code == 500 %>
            <h3 class="h4 mb-3 text-secondary">Something went wrong on our end</h3>
            <p class="text-muted">An internal error occurred. Our administration team has been notified of the breakdown.</p>
          <% elsif @status_code == 422 %>
            <h3 class="h4 mb-3 text-warning">Unprocessable Entity</h3>
            <p class="text-muted">The security token expired or the change you requested could not be verified.</p>
          <% else %>
            <h3 class="h4 mb-3">Unexpected Error</h3>
            <p class="text-muted">An unexpected routing condition occurred.</p>
          <% end %>

          <div class="mt-4">
            <%= link_to "Return to Dashboard", root_path, class: "btn btn-outline-primary" %>
            <%= link_to "Sign In Page", new_session_path, class: "btn btn-link" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

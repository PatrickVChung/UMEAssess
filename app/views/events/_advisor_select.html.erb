<turbo-frame id="advisor_selection_frame">
  <div class="row mb-0">
    <%= label_tag :Advisor, nil, class: "control-label col-md-2 right-label" %>
    <div class="col-sm-6">
      <%= select_tag :advisor,
            options_for_select(@filtered_advisors || []),
            include_blank: "---",
            required: true,
            class: "form-select" %>
    </div>
  </div>
</turbo-frame>

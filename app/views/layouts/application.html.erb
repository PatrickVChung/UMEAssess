<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "REDEI V8" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "application", "flatpickr",  "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module", defer: true %>

  </head>

  <%# KEY CHANGE: Attach the controller here so it covers the entire page %>
  <body data-controller="side-panel">
    <nav class="navbar navbar-expand-lg navbar-light bg-light-green mb-4 sticky-top shadow-sm">
      <div class="container">
        <%= link_to root_path, class: "navbar-brand d-flex align-items-center" do %>
          <%= image_tag "OHSU-RGB-4C-POS.png", alt: "Logo", height: "32", class: "me-2" %>
          REDEI V8
        <% end %>
        <div class="navbar-nav ms-auto">
          <% if Current.user %>
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item">
                  <%= link_to "Home", root_path, class: "nav-link #{'active' if current_page?(root_path)}" %>
                </li>
            </ul>

            <span class="nav-link text-light">Welcome, <%= Current.user.display_name %>!</span>

            <% if Current.user.coaching_type == 'dean' %>
              <%= form_with url: searches_path, method: :get, class: "d-flex me-3", local: true,
                    data: { turbo_frame: "results" } do |form| %>
                <%= form.label :search, "Student/Cohort Search", class: "form-control" %>
                <%= form.text_field :search, class: "form-control form-control-sm me-2", placeholder: "Search Student LastName…" %>
              <% end %>
            <% end %>

            <div class="dropdown">
              <button
                class="btn btn-outline-secondary dropdown-toggle"
                type="button"
                data-bs-toggle="dropdown"
                aria-expanded="false"
              >


              <i class="bi bi-person-circle me-1"></i>
              <%= Current.user.display_name %>

              </button>

              <ul class="dropdown-menu dropdown-menu-end">
                <%# Admin link (admins only) %>
                <% if Current.user.superadmin? %>
                  <li>
                    <%= link_to "Admin Dashboard",
                        admin_root_path,
                        class: "dropdown-item",
                        data: { turbo: false },
                        target: :_blank   %>
                  </li>
                  <li><hr class="dropdown-divider"></li>
                <% end %>

                <%# Logout %>
                <li>
                  <%= button_to "Logout",
                      session_path,
                      method: :delete,
                      class: "dropdown-item",
                      form: { data: { turbo: false } } %>
                </li>
              </ul>
            </div>
            ``
          <% else %>
            <%= link_to "Login", new_session_path, class: "nav-link" %>
          <% end %>
        </div>
      </div>
    </nav>

    <div id="flash-container">
      <%= render "layouts/flashes" %>
    </div>

    <main class="container-fluid pt-1">
      <%= yield %>
      <div id="modal-container"></div>
    </main>

    <%# The side panel div - Controller removed from here as it is now on the body %>
    <div class="offcanvas offcanvas-end offcanvas-wide"
          tabindex="-1"
          id="side_panel"
          data-bs-scroll="true"
          aria-labelledby="sidePanelLabel">
      <div class="offcanvas-body">
        <turbo-frame id="remote_side_panel" data-side-panel-target="frame">
          <div class="text-center mt-5">
            <div class="spinner-border text-primary" role="status"></div>
          </div>
        </turbo-frame>
      </div>
    </div>

  </body>
</html>

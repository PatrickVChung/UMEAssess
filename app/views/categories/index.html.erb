<%# app/views/categories/index.html.erb %>
<div class="container mt-5">
  <div class="row">

    <%# Form Entry Panel %>
    <div class="col-md-5">
      <h3 class="mb-3">Manage Category</h3>
      <%= turbo_frame_tag "new_category_frame" do %>
        <%# Inline creation slot, targeted by your creation streams %>
        <%= render "categories/form", category: @category %>
      <% end %>
    </div>

    <%# Active Feed Panel %>
    <div class="col-md-7">
      <h3 class="mb-3">All Categories</h3>
      <div id="categories_list">
        <%= render @categories %>
      </div>
    </div>

  </div>
</div>

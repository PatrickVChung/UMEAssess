<%# app/views/categories/_category.html.erb %>
<%= turbo_frame_tag dom_id(category) do %>
  <div class="card mb-3 border-start border-primary border-4 shadow-sm">
    <div class="card-body d-flex justify-content-between align-items-start">
      <div>
        <h4 class="card-title text-primary mb-1"><%= category.name %></h4>

        <div class="mt-2">
          <% if category.sub_categories.any? %>
            <% category.sub_categories.each do |sub| %>
              <span class="badge bg-light text-dark border me-1 fs-6">
                <%= sub.name %> <%= "★" if sub.selected? %>
              </span>
            <% end %>
          <% else %>
            <small class="text-muted italic">No sub-categories assigned</small>
          <% end %>
        </div>
      </div>

      <div class="btn-group">
        <%# This link forces the current frame to turn into the Edit Form %>
        <%= link_to "Edit", edit_category_path(category), class: "btn btn-sm btn-outline-secondary" %>

        <%= link_to "Delete", category_path(category),
                    class: "btn btn-sm btn-outline-danger",
                    data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
      </div>
    </div>
  </div>
<% end %>

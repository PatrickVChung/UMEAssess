
<div class="container" >
    <div class="card">
      <div class="card-body">
        <%= form_tag(competency_rpt_new_competencies_path, method: "get", id: 'competency_rpt_form') do %>
        <div class="row g-3 align-items-center">

          <div class="col-auto">
            <label for="cohort" class="col-form-label fw-bold">Cohort</label>
          </div>
          <%= select_tag :permission_group_id, options_from_collection_for_select(@permission_groups, "id", "title", selected: params[:permission_group_id]), include_blank: '--',
               prompt: "Please Select a Cohort", onchange: "this.form.submit();", class: "form-control w-auto"  %>
        </div>
      </div>

    </div>


  <br />
  <% if !@cohort_competency.blank? %>
      <%= render partial: 'detail_competency_rpt' %>
    <% end %>
  <% end %>


</div>

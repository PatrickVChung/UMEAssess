<div class="card shadow-sm mb-4">
  <div class="card-header bg-light py-3">
    <h5 class="card-title mb-0 text-secondary fw-semibold">EPA Badges</h5>
  </div>

  <div class="card-body d-flex flex-wrap justify-content-center justify-content-md-start gap-4 align-items-top">
    <% hf_GetNewEPA.map(&:upcase).each do |epa_code| %>
      <% badge_data = @student_badge_info[epa_code] %>

      <% if !badge_data["status_date"].nil? && hf_ok_to_release_badge(badge_data["status_date"], @release_date) %>
        <% if badge_data["status"] == 'Badge' && !@spec_program_msg.include?("Paused badging") %>

          <figure class="text-center mb-0" style="width: 175px;">
            <%= image_tag "epa/#{epa_code}.png", size: "175x175", class: "img-fluid rounded mb-2", alt: "EPA #{epa_code} Badge" %>
            <figcaption class="text-start small text-muted">
              <span class="d-block text-purple fw-medium">Status: <strong class="text-dark"><%= badge_data["status"] %></strong></span>
              <span class="d-block">Awarded: <strong><%= hf_format_date(badge_data["status_date"]) %></strong></span>
              <span class="d-block">Expires: <strong><%= hf_format_date(badge_data["expiration_date"]) %></strong></span>
            </figcaption>
          </figure>

        <% else %>

          <figure class="text-center mb-0" style="width: 175px;">
            <%= image_tag "epa/#{epa_code}.png", size: "175x175", class: "img-fluid rounded opaque-image mb-2", alt: "EPA #{epa_code} Badge" %>
            <figcaption class="text-primary fw-medium small"><%= badge_data["status"] %></figcaption>
          </figure>

        <% end %>
      <% else %>

        <figure class="text-center mb-0" style="width: 175px;">
          <%= image_tag "epa/#{epa_code}.png", size: "175x175", class: "img-fluid rounded opaque-image mb-2", alt: "EPA #{epa_code} Badge" %>
          <figcaption class="text-secondary small">Badge status: Not Yet</figcaption>
        </figure>

      <% end %>
    <% end %>
  </div>
</div>

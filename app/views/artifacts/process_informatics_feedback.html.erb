<%= turbo_frame_tag "upload_InformaticsFeedback" do %>
  <h5>Loading Informatics Feedback</h5>

  <% summary = @log_results.last %>
  <% log_entries = @log_results[0...-1] %>

  <div class="row g-3 my-3">
    <div class="col-md-4">
      <div class="card text-bg-success">
        <div class="card-body">
          <h6 class="card-title">Updated</h6>
          <p class="card-text fs-4 fw-bold"><%= summary["no_updated"] %></p>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card text-bg-warning">
        <div class="card-body">
          <h6 class="card-title">Not Updated</h6>
          <p class="card-text fs-4 fw-bold"><%= summary["no_not_updated"] %></p>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card text-bg-light border">
        <div class="card-body">
          <h6 class="card-title">Total Processed</h6>
          <p class="card-text fs-4 fw-bold"><%= summary["total_count"] %></p>
        </div>
      </div>
    </div>
  </div>
<% end %>

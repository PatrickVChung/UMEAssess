<div class="container-fluid">
  <div class="card">
    <div class="card-header">
      <h4>Upload Documents</h4>
    </div>

    <div class="card-body">
      <%= form_with model: artifact, data: { controller: "artifact-form" } do |f| %>

        <% if f.object.errors.any? %>
          <div class="alert alert-danger">
            <ul>
              <% f.object.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <% unless ["student", "coach"].include?(Current.user.coaching_type) %>
          <div class="row mb-3">
            <%= f.label :cohort, class: "col-sm-2 col-form-label" %>
            <div class="col-sm-4">
              <%= select_tag :permission_group_id,
                    options_for_select(@student_groups.map { |s| [s.title, s.id] }, params[:permission_group_id]),
                    prompt: "Please Select Cohort",
                    class: "form-select",
                    data: { action: "change->artifact-form#loadStudents" } %>
            </div>
          </div>

          <div class="row mb-3">
            <%= f.label :student, class: "col-sm-2 col-form-label" %>
            <div class="col-sm-4">
              <%= select_tag :user_id,
                    options_for_select(@cohort_students.map { |s| [s.full_name, s.id] }, params[:user_id]),
                    prompt: "Please Select a Student",
                    class: "form-select",
                    data: { artifact_form_target: "studentSelect" } %>
            </div>
          </div>
        <% end %>

        <div class="row mb-3">
          <%= f.label :category_id, "Category", class: "col-sm-2 col-form-label" %>
          <div class="col-sm-4">
            <%= f.collection_select :category_id,
                  @categories,
                  :id,
                  :name,
                  { include_blank: "---" },
                  name: "title",
                  prompt: "Please Select a Category",
                  class: "form-select",
                  data: { action: "change->artifact-form#loadSubcategories" } %>
          </div>
        </div>

        <div class="row mb-3">
          <%= f.label :sub_category_id, "Sub-category", class: "col-sm-2 col-form-label" %>
          <div class="col-sm-4">
            <%= f.select :sub_category_id,
                  [],
                  { include_blank: "---" },
                  class: "form-select",
                  name: "content",
                  prompt: "Please Select a SubCategory",
                  data: { artifact_form_target: "subcategorySelect" } %>
          </div>
        </div>

        <div class="row mb-3" id="artifact_upload_container">
          <%= f.label :documents, "Documents", class: "col-sm-2 col-form-label" %>
          <div class="col-sm-4">
            <%= f.drag_and_drop_file_field :documents, "Drag & Drop documents here!", class: "form-control", id:  "drag-and-drop-file-field"%>

          </div>
        </div>

        <div class="mt-3">
          <%= f.submit "Upload Document(s)", class: "btn btn-primary" %>
        </div>

      <% end %>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <h5 class="mb-0">Attention! Formative Feedback File Upload</h5>
    </div>
    <div class="card-body">
      <p><strong class="text-primary">Category:</strong> Formative feedback</p>
      <p><strong class="text-primary">Subcategory:</strong> Formative Feedback File (Tab Delimited File)</p>
      <p><strong class="text-danger">File Upload Naming Convention:</strong> <strong class="text-dark">Med30_BLHD_Formative_Feedback_CSA1.txt as example.</strong></p>
      <p class="fw-bold fst-italic">** The file (eg. Med 30 CSA #1 Scores With Exportable Comments.xlsx) comes from Simulation Center, and you MUST save the file as Tab delimited file with above naming convention. Please refer to the block Syllabus to see whether it is CSA1, CSA2, or OSCE.</p>

      <hr>

      <p><strong class="text-primary">Category:</strong> Formative feedback</p>
      <p><strong class="text-primary">Subcategory:</strong> Informatics Feedback File (Tab Delimited File)</p>
      <p><strong class="text-danger">File Upload Naming Convention: </strong> <strong class="text-dark">M30 FUND Comp 5 ISA Feedback 102026.txt as example.</strong></p>
      <p class="fw-bold fst-italic">** This file comes from Gretchen and be sure the file name format is exactly as shown in the above example.</p>
    </div>
  </div>
</div>

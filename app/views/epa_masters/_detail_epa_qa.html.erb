<br />
<span>
  <h4 style="text-align:center"> Detail EPA Q/A (%) Report
    <%= link_to ('<i class="fa fa-download"></i>').html_safe, download_file_epa_masters_path(file_name: 'epa_qa.txt') %>
  </h4>
    <h5 style="text-align:center">Cohort: <%= @cohort_title %></h5>
</span>

<table id="EpaQaTable" class="table table-hover table-striped responsive" data-sort="true" >
  <thead>
    <tr class="filters">
      <% @epa_qa_data.first.keys.each do |key| %>
        <th style="text-align:left"><%= key.upcase %></th>
      <% end %>
    </tr>
  </thead>
    <% @epa_qa_data.each do |qa| %>
      <tr>
        <% qa.each do |key, val| %>
          <%# Check if val is a number and less than 100 %>
          <% is_low_score = val.is_a?(Numeric) && val < 100 %>
          <td class="<%= 'text-danger fw-bold' if is_low_score %>">
            <%= val %>
          </td>
        <% end %>

      </tr>
    <% end %>

</table>

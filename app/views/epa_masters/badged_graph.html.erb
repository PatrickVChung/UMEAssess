<div class="row justify-content-center">
  <div class="card" >
     <div class="card-body">
       <div class="d-flex justify-content-center align-items-center">
          <% title, series_data, categories = hf_create_epa_badged_graph_series(@all_cohorts_badges) %>
          <div data-controller="highcharts"
               data-highcharts-series-value="<%= series_data.to_json %>"
               data-highcharts-categories-value="<%= categories.to_json %>"
               data-highcharts-title-value="<%= title %>"
               data-highcharts-chart-type-value="column"
               data-highcharts-y-title-value="# of Badges Awarded"
               data-highcharts-y-max-value="160"
               style="width:1200px; height:500px;">
          </div>

        </div>

      </div>
  </div>
</div>

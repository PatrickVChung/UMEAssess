<span>
  <h5 style="text-align:center"> # of WBAs per EPA Report - Cohort: <b><%= @cohort_title %> </b>
  <%= link_to ('<i class="bi bi-download"></i>').html_safe, download_file_epa_masters_path(file_name: 'wba_epa.txt') %>
  </h5>
  <h6 style="text-align:center"> Start Date: <b><%= @start_date %></b> End Date: <b><%= @end_date %></b></h6>
</span>
<hr>
<div data-controller="datatable">
  <table data-datatable-target="table" id="WbaEpaTable" class="table table-hover table-striped responsive" data-sort="true" >
    <thead>
      <tr class="filters">
        <% @wba_epa_data.first.keys.each do |key| %>
          <th style="text-align:center"><%= key %></th>
        <% end %>
      </tr>
    </thead>
      <% @wba_epa_data.each do |wba| %>
        <tr>
          <% wba.each do |key, val| %>

            <%# Check if val is a number and less than 100 %>
            <% is_low_score = val.is_a?(Numeric) && val <= 1 %>
            <td style="text-align:center" class="<%= 'text-danger fw-bold' if is_low_score %>">
              <%= val %>
            </td>
          <% end %>
        </tr>
      <% end %>
  </table>
</div>



  <div class="card">
    <div class="card-body">
        <div id="epa_masters">
          <% program = @user&.spec_program %>
          <% if program.to_s.include?("Paused badging") %>
            <h3 style="display: inline-block">Badging EPAs - <%= @full_name.to_s %></h3>
            <h5 style="display: inline-block;color:#FC6C85">
              &nbsp;&nbsp;[Student Status: <%= program %>]
            </h5>
          <% else %>
            <h3 style="display: inline-block">Badging EPAs - <%= @full_name.to_s %></h3>
            <h5 style="display: inline-block">
              &nbsp;&nbsp;[Student Status: <%= program.presence || "N/A" %>]
              &nbsp;&nbsp;<%= link_to 'Query AI',
                query_ai_epa_masters_path(full_name: @full_name, user_id: @user&.id),
                class: "btn btn-primary", target: :_blank %>
            </h5>
          <% end %>
          <table class="responsive nowrap table table-hover" id="epa_masters">
            <thead>
              <tr>
                <th data-data="epa">EPA</th>
                <th data-data="status">Status</th>
                <th data-data="EntrustmentReviews">Entrustment Reviews</th>
              </tr>
            </thead>
            <tbody>
              <% epa_masters.each do |epa_master| %>
                <%= render partial: "epa_masters/epa_masters_row",
                           locals: { epa_master: epa_master } %>
              <% end %>
            </tbody>
          </table>
        </div>

    </div>
  </div>

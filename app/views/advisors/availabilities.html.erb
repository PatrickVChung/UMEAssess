<!-- app/views/advisors/availabilities.html.erb -->

<turbo-frame id="availability_frame">
  <!-- app/views/advisors/availabilities.html.erb -->
  <div class="card mb-1">
    <div class="card-header fw-bold">Available Appointment(s)</div>
    <div class="card-body">
      <div class="mb-3">
        <% if @events.present? %>
          <table class="table table-striped table-responsive table-hover" id="all_events_table" >
            <thead class="filters">
                <th data-data="title">Title</th>
                <th data-data="description">Description</th>
                <th data-data="start_date">Start date</th>
                <th data-data="end_date">End date</th>
                <th data-data="function">Function</th>
            </thead>

            <% @events.each do |event| %>
              <tr>
                <% if event.user_id.nil? %>
                  <td><%= event.title %></td>
                <% else %>
                  <% student = User.find(event.user_id) %>
                  <td><%= link_to(event.title, coaching_student_path(student), target: '_blank') %></td>
                <% end %>
                <td><%= event.description %></td>
                <td><%= event.start_date.strftime("%m/%d/%Y %H:%M %P - %A") %></td>
                <td><%= event.end_date.strftime("%m/%d/%Y %H:%M %P - %A")%></td>
                <td><%= label_tag :event_id, "select", style: "color:#338BA8;"  %> &nbsp;
                    <%= radio_button_tag :event_id, "#{event.id}" %></td>
              </tr>
            <% end %>
          </table>
        <% else %>
          <%= render partial: "other_availabilities" %>
        <% end %>
      </div>
    </div>
  </div>
</turbo-frame>

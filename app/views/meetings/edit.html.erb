<%= turbo_frame_tag "remote_side_panel" do %>
  <%# CSS Grid: 3 rows (Header, Body, Footer) %>
  <div style="display: grid; grid-template-rows: auto 1fr auto; height: 100vh; width: 100%; overflow: hidden;">

    <div class="p-3 border-bottom bg-white">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <h3 class="h5 mb-0 text-primary">Edit Meeting: <%= @meeting.id %> (<%= @meeting.user.full_name %>)</h3>

        </div>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
      </div>
    </div>

    <%= form_with(model: @meeting, id: "meeting-form", class: "overflow-auto p-4 bg-light") do |f| %>
      <%= render partial: "meetings/form", locals: { f: f, meeting: @meeting } %>
    <% end %>

  </div>
<% end %>

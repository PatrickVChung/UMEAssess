
<div class="container mt-2" data-controller="meeting-form" >

  <%= form_with(model: Meeting.new,
                id: "MeetingForm",
                data: {
                      turbo_frame: "_top", action: "turbo:submit-end->modal#submitEnd"
                }) do |f| %>

    <%# Shared Hidden Fields %>
    <%= f.hidden_field :user_id, value: Current.user.id %>
    <%= f.hidden_field :m_status, value: 'Scheduled' %>
    <%= f.hidden_field :location, value: 'Phone/Webex' %>

    <!-- Advisor Type -->
    <div class="row mb-3 align-items-center">
      <%= f.label :advisor_type_id, class: "col-sm-2 col-form-label text-sm-end" %>
      <div class="col-sm-4">
        <%= f.collection_select :advisor_type_id,
              AdvisorType.all.order(:name),
              :id, :name,
              { prompt: "Select advisor type" },
               class: "form-control" ,
              data: {
                action: "change->meeting-form#loadAdvisors"
              } %>
      </div>
    </div>

    <!-- Advisors (loaded dynamically) -->
    <turbo-frame id="advisors_frame"></turbo-frame>

    <!-- Availability (loaded dynamically) -->
    <turbo-frame id="availability_frame"></turbo-frame

      <!-- Primary Reasons -->
    <turbo-frame id="primary_reasons_frame">
      <!-- empty initially -->
    </turbo-frame>


    <%# Dynamic Section: Appointment Selection %>
    <div class="card mb-3">
      <div class="card-body">

        <div class="mt-3">
          <div class="form-check">
            <%= check_box_tag :email_notification, "1", true, class: "form-check-input" %>
            <%= label_tag :email_notification, "Email Notification", class: "form-check-label" %>
          </div>
        </div>
      </div>
    </div>

    <%# Notes Section %>
    <div class="card mb-3">
      <div class="card-body bg-light">
        <div class="mb-1">
          <%= f.label :notes, 'Student Notes (Optional)', class: "fw-bold" %>
          <%= f.text_area :notes, class: "form-control", rows: 2 %>
        </div>
      </div>
    </div>

    <div class="mt-4">
      <%= f.submit "Save Meeting", class: "btn btn-primary btn-lg", data: { turbo_submits_with: "Saving..." } %>
    </div>
  <% end %>
</div>

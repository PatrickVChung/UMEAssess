<div class="card shadow-sm">
  <div class="card-header bg-light">
    <% if Current.user.coaching_type=='student' && params[:student_id].present? %>
      <div class="row">
        <div class="col-md-8 col-lg-6 d-flex align-items-center gap-3">
          <h5 class="mb-0"><%= Current.user.full_name %></h5>
          <%= link_to "Create New Appointment", new_meeting_path, class: "btn btn-primary", data: { turbo_stream: true } %>
        </div>
      </div>
    <% else %>
      <%= form_with(url: meetings_path, method: :get, data: { turbo_frame: "meeting_details" }) do |f| %>
        <div class="row align-items-center">
          <%# Label and Select on the same line using Bootstrap Grid %>
          <%= f.label :student_id, "Select Student", class: "col-auto col-form-label fw-bold" %>
          <div class="col-md-8 col-lg-4">
            <div class="input-group">
              <%= f.collection_select :student_id, @students, :uuid, :full_name,
                  { prompt: "Search...", selected: params[:student_id] },
                  { class: "form-control", onchange: "this.form.requestSubmit();" } %>

              <% if params[:student_id].present? %>
                <span class="input-group-text small">
                  <% user = User.find_by(uuid: params[:student_id]) %>
                   <label class="form-label fw-bold">Program Status:</label>&nbsp;<%= user.spec_program %> (<%= user.permission_group.title[/\((.*?)\)/, 1] %>) <%= user.career_interest %>
                   <% if Current.user.coaching_type != 'student' %>
                     <% if Advisor.find_by(email: Current.user.email).present? %>
                       &nbsp;<%= link_to "Create Retro-Appointment", new_meeting_path(user_id: user.id), class: "btn btn-sm btn-primary", data: { turbo_stream: true } %>
                     <% end %>
                   <% end %>
                </span>
              <% end %>
            </div>
          </div>
        </div>

      <% end %>
    </div>
  <% end %>


  <div class="card-body">
    <div id="meeting_details">
      <% if @meetings %>

        <%= render "meeting_list", meetings: @meetings %>
      <% else %>
        <p class="text-muted mb-0">Please select a student to view meeting history.</p>
      <% end %>
    </div>
  </div>
</div>

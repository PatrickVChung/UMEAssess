<%# 1. NBME SECTION %>
<% nbme_hash = meeting.nbme_form.present? ? JSON.parse(meeting.nbme_form) : {} %>
<%# We check if the hash has any values that aren't blank %>
<% if nbme_hash.values.any?(&:present?) %>
  <h5 style="color: #4c0946;">Practice Test Scores</h5>
  <table class="responsive table table-hover">
    <thead>
      <tr>
        <th>NBME Form</th>
        <th>% Likelihood of Passing</th>
        <th>Date Completed</th>
      </tr>
    </thead>
    <tbody>
      <% (1..3).each do |i| %>
        <% values = nbme_hash.select { |k, v| k.include?("_#{i}") && v.present? }.values %>
        <% if values.any? %>
          <tr>
            <% values.each do |val| %>
              <td><%= val %></td>
            <% end %>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>
  <hr>
<% end %>

<%# 2. UWORLD SECTION %>
<% uworld_hash = meeting.uworld_info.present? ? JSON.parse(meeting.uworld_info) : {} %>
<% if uworld_hash.values.any?(&:present?) %>
  <table class="responsive table table-hover">
    <thead>
      <tr>
        <th>Uworld Practice Test Score</th>
        <th>Date Completed</th>
      </tr>
    </thead>
    <tbody>
      <% (1..2).each do |i| %>
        <% values = uworld_hash.select { |k, v| k.include?("_#{i}") && v.present? }.values %>
        <% if values.any? %>
          <tr>
            <% values.each do |val| %>
              <td><%= val %></td>
            <% end %>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>
  <hr>
<% end %>

<%# 3. QBANK SECTION %>
<% qbank_hash = meeting.qbank_info.present? ? JSON.parse(meeting.qbank_info) : {} %>
<% if qbank_hash["q_bank_no_of_correct_questions"].present? || qbank_hash["q_bank_no_of_questions"].present? %>
  <h6 style="color: #4c0946;">Q Bank Performance</h6>
  <p>
    % Correct over your last 6 random blocks: <b><%= qbank_hash["q_bank_no_of_correct_questions"] %></b><br />
    # of Q-Bank questions completed: <b><%= qbank_hash["q_bank_no_of_questions"] %></b>
  </p>
<% end %>

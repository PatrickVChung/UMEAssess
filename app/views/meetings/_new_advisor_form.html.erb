<%# 1. Configuration Logic: Determine what to show based on advisor_type %>
<div class="container mt-2">
  <%
    is_wellness = (advisor_type == 'Wellness')
    is_deib = (advisor_type == 'DEIB')
    is_academic = ['Academic', 'Academic/Student Affairs', 'Academic: Step 1 Advising'].include?(advisor_type)
    is_career = advisor_type.to_s.include?('Career') || advisor_type == 'Assist Dean'
    # Determine which helper methods to call for checkboxes
    advisor_subjects = case
      when is_career then hf_career_advisor_discussed_for_select
      when is_academic then hf_academic_advisor_discussed_for_select
      when is_wellness then hf_wellness_advisor_discussed_for_select
      when is_deib then hf_diversity_navigator_for_select
      else hf_academic_advisor_discussed_for_select
    end

    advisor_outcomes = case
      when is_academic then hf_meeting_ipas_for_select
      when is_career then hf_meeting_ipps_for_select
      when is_wellness then hf_wellness_advisor_discussed_for_select
      else hf_meeting_ipas_for_select
    end
  %>

  <%
    select_primary_reasons = case
    when advisor_type.name.match?(/Career|ERAS/) then hf_career_primary_for_select
    when advisor_type.name.match?(/Academic: Step 1/) then hf_academic_primary_step1_for_select
    when advisor_type.name.match?(/Academic/) then hf_academic_primary_for_select
    when advisor_type.name == 'Wellness' then hf_wellness_primary_for_select
    when advisor_type.name == 'DEIB' then hf_diversity_navigator_for_select
    when advisor_type.name == 'Assist Dean' then hf_assist_dean_for_select
      else hf_meeting_tags_for_select
    end
  %>

  <%= form_with model: meeting, id: "meeting_advisor_form", data:{ turbo_frame: "_top", action: "turbo:submit-end->modal#submitEnd"  } do |f| %>

    <%# Hidden Metadata %>
    <div class="advisors-type" data-advisor_type="<%= advisor_type %>" hidden></div>
    <%= f.hidden_field :advisor_id, value: advisor_id %>
    <%= f.hidden_field :advisor_type, value: advisor_type.name %>
    <%= f.hidden_field :user_id, value: student.id %>
    <%= f.hidden_field :location, value: 'Phone/Webex/Email/Retro-Appt' %>
    <%= f.hidden_field :m_status, value: 'Completed' %>

    <div class="mb-1">
      Advisor Name: <b><%= Current.user.full_name %></b><br />
      Advisor Type: <b><%= advisor_type.name %></b>
    </div>

    <%# SECTION 1: Standard Appointment Details (Shared by all) %>
    <div class="card mb-1">
      <div class="card-body bg-light">
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label fw-bold">Time Slot (Mins)</label>
            <%= select_tag :time_slot, options_for_select([30, 45, 60], 45), class: "form-select" %>
          </div>
          <div class="col-md-6">
            <label class="form-label fw-bold">Appointment Date <i class="bi bi-calendar"></i></label>
            <input type="datetime-local" id="retroDatetime" name="retroDatetime" class="form-select">
          </div>
        </div>

        <div class="mt-3">
          <div class="form-check">
            <input class="form-check-input" type="checkbox" id="email_notification" name="email_notification">
            <label class="form-check-label">Email Notification</label>
          </div>

          <% if is_career %>
            <div class="form-check">
              <% is_grad = student.spec_program.include?("Graduated") && current_user.username != 'mansoord' %>
              <%= check_box_tag :graduated_student, "1", is_grad, class: "form-check-input" %>
              <label class="form-check-label">Met with Graduated Student?</label>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="card mb-1">
      <div class="card-header fw-bold">Primary Reason(s)</div>
      <div class="card-body custom-card-body">
        <div class="row">
          <%= collection_check_boxes(:meeting, :subject, select_primary_reasons, :first, :first) do |b| %>
            <div class="col-md-6 form-check">
              <%= b.check_box(class: 'form-check-input MyCheckBox') %>
              <%= b.label(class: 'form-check-label') %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <%# SECTION 2: Discussed Topics & Outcomes %>
    <% unless is_deib %>
      <div class="card mb-1">
        <div class="card-header fw-bold">Discussion & Outcomes</div>
        <div class="card-body custom-card-body"">

          <label class="fw-bold d-block mb-2">Advisor Discussed:</label>
          <div class="row">
            <%= collection_check_boxes(:meeting, :advisor_discussed, advisor_subjects, :first, :first) do |b| %>
              <div class="col-md-6 form-check">
                <%= b.check_box(class: 'form-check-input MyCheckBoxAdvisorDiscussed') %>
                <%= b.label(class: 'form-check-label') %>
              </div>
            <% end %>
          </div>

          <% if is_academic %>
            <%= f.text_field :academic_discussed_other, placeholder: "Other academic topics...", class: "form-control mt-2" %>
            <hr>
            <label class="fw-bold d-block mb-2">Study Resources:</label>
            <div class="row">
              <%= collection_check_boxes(:meeting, :study_resources, hf_academic_study_resources_for_select, :first, :first) do |b| %>
                <div class="col-md-4 form-check">
                  <%= b.check_box(class: 'form-check-input') %>
                  <%= b.label(class: 'form-check-label') %>
                </div>
              <% end %>
            </div>
            <%= f.text_field :study_resources_other, placeholder: "Other resources...", class: "form-control mt-2" %>
          <% elsif is_career %>
            <%= f.text_field :career_discussed_other, placeholder: "Other career topics...", class: "form-control mt-2" %>
          <% end %>

          <hr>

          <label class="fw-bold d-block mb-2">Outcomes / Recommendations:</label>
          <div class="row">
            <%= collection_check_boxes(:meeting, :advisor_outcomes, advisor_outcomes, :first, :first) do |b| %>
              <div class="col-md-6 form-check">
                <%= b.check_box(class: 'form-check-input') %>
                <%= b.label(class: 'form-check-label') %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <%# SECTION 3: Documentation %>
    <div class="card mb-1 border-primary">
      <div class="card-body ">
        <div class="mb-1">
          <%= f.label :notes, 'Student Notes (Optional)', class: "fw-bold" %>
          <%= f.text_area :notes, class: "form-control", rows: 2 %>
        </div>
        <div>
          <%= f.label :advisor_notes, 'Advisor Meeting Documentation', class: "fw-bold" %>
          <%= f.text_area :advisor_notes,
              class: "form-control",
              rows: 5,
              value: (is_wellness ? "Met with student." : f.object.advisor_notes) %>
        </div>
      </div>
    </div>

    <div class="mt-4">
      <%= f.submit "Save Meeting", class: 'btn btn-primary btn-lg w-100', id: 'meeting-submit', data: { turbo_submits_with: "Saving..." } %>
    </div>
  <% end %>
</div>

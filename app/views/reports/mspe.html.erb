<% if Current.user.coaching_type != 'student' %>
  <br />
  <div id="container-fluid">
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-body bg-body-tertiary rounded">
        <%= form_with url: mspe_reports_path, method: :get, class: "row row-cols-lg-auto g-3 align-items-center", data: { controller: "auto-submit" } do |f| %>
          <div class="col-12">
            <div class="input-group">
              <label for="cohort" class="input-group-text fw-bold">Cohort</label>
              <%= f.select :cohort,
                    options_from_collection_for_select(@permission_groups_mspe, :id, :title, params[:cohort]),
                    { include_blank: "--", prompt: "Please Select a Cohort" },
                    class: "form-select",
                    data: { action: "change->auto-submit#submit" } %>
            </div>
          </div>

          <% if params[:cohort].present? %>
            <div class="col-12">
              <div class="input-group">
                <label for="email" class="input-group-text fw-bold">Student</label>
                <%= f.select :email,
                      options_for_select(hf_student_list(params[:cohort]), params[:email]),
                      { prompt: "Please Select a Student" },
                      class: "form-select",
                      data: { action: "change->auto-submit#submit" } %>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>

    <div class="card">
      <div class="card-body">
        <div id="mspe_data">
          <%= render partial: "mspe_data",  locals: {mspe_data: @mspe_data} %>
        </div>
      </div>
    </div>
  </div>
<% else %>
  <br /> <br />
  <h5> You are NOT authorized to access this page! </h5>
<% end %>

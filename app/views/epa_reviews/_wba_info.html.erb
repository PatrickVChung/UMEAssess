<div class="card">
  <div class="card-header">
    <h5>QA Complete %: <b style="color:purple"><%= qa_percent %></b> |
    Total # of WBAs: <b style="color:blue"><%= wba.sum %></b></h5>
  </div>
  <div class="card-body">
      <% if !@wba.blank? %>
        <table class="responsive table-sm table-bordered table-hover" style="width:400px">
          <tr>
              <th class="text-center">Instance</th>
              <th class="text-center">Total Count</th>
          </tr>
          <% for i in 0..3do %>
            <tr>
                <td class="text-center"><%= hf_wba_instance_def(i+1) %></td>
                <td class="text-center"><%= "#{wba[i]}" %> </td>
            </tr>
          <% end %>
        </table>
      <% end %>

      <% if !@bls.nil? %>
        <% if @bls.expiration_date.after? (Date.today) %>
          BLS Expiration Date: <b style="color:green"><%= @bls.expiration_date %></b> <br />
        <% else %>
          BLS Expiration Date: <b style="color:red"><%= @bls.expiration_date %> *** Expired!</b> <br />
        <% end %>
        BLS Comments: <%= @bls.comments.to_s %>
      <% else %>
        No BLS data!
      <% end %>
    </div>
  </div>


<div data-controller="epa-review-form-logic">
  <div id="col-reviewer2">
    <div class="form-group">
      <%= f.label :review_date2,  'Review Date', class: "form-label fw-bold" %>
      <%= f.date_field :review_date2,  html5: true, class: 'form-control' %>
    </div>

    <div class="form-group">
      <%= f.label :reviewer2, 'Reviewer', class: "form-label fw-bold" %>
      <%= f.text_field :reviewer2,  html5: {selected: true}, class: 'form-control'  %>
    </div>

    <div class="form-group" id="epa_review_badge_decision2">
      <%= f.label :badge_decision2, 'Badge Decision', class: "form-label fw-bold" %>
      <%= f.radio_button :badge_decision2, 'Not Yet', class: "badge_decision2_not_yet", data: { action: "change->epa-review-form-logic#updateForm" } %>
      <%= f.label :badge_decision2, "Not Yet", value: 'Not Yet' %>&nbsp;&nbsp;
      <%= f.radio_button :badge_decision2, 'Badge', class: "badge_decision2_badge", data: { action: "change->epa-review-form-logic#updateForm" } %>
      <%= f.label :badge_decision2, "Badge", value: 'Badge' %>&nbsp;&nbsp;
      <%= f.radio_button :badge_decision2, 'Deny', class: "badge_decision2_deny", data: { action: "change->epa-review-form-logic#updateForm" } %>
      <%= f.label :badge_decision2, "Deny", value: 'Deny' %>&nbsp;&nbsp;
    </div>
    <div class="form-group">
      <%= f.label :reason2, 'Reason', class: "form-label fw-bold" %><br />&nbsp;&nbsp;
      <%= f.radio_button :reason2, @eg_reasons.first, class: "reason2_met_min", data: { epa_review_form_logic_target: "metMin" } %>
      <%= f.label :reason2, @eg_reasons.first, value: @eg_reasons.first %><br />&nbsp;&nbsp;
      <%= f.radio_button :reason2, @eg_reasons.second, class: "reason2_have_not_met_min", data: { epa_review_form_logic_target: "notMet" } %>
      <%= f.label :reason2, @eg_reasons.second, value: @eg_reasons.second %><br />
     </div>

    <div class="form-group" id="epa_review_trust2">
      &nbsp;&nbsp;
      <%= f.label :trust2, 'Trust', class: "form-label fw-bold" %>&nbsp;&nbsp;
      <!-- <%= f.select :trust1, @decision_option,  {}, {class: 'form-control'} %> -->
      <%= f.radio_button :trust2, @decision_option.first, data: { epa_review_form_logic_target: "grounded" }  %>
      <%= f.label :trust2, @decision_option.first, value: @decision_option.first %>&nbsp;&nbsp;
      <%= f.radio_button :trust2, @decision_option.second %>
      <%= f.label :trust2, @decision_option.second, value: @decision_option.second %>&nbsp;&nbsp;
      <%= f.radio_button :trust2, @decision_option.third, data: { epa_review_form_logic_target: "distrust" }  %>
      <%= f.label :trust2, @decision_option.third, value: @decision_option.third %>&nbsp;&nbsp;
      <%= f.radio_button :trust2, @decision_option[3] %>
      <%= f.label :trust2, @decision_option[3], value: @decision_option[3] %>&nbsp;&nbsp;
      <%= f.radio_button :trust2, @decision_option[4], data: { epa_review_form_logic_target: "noDecision" }  %>
      <%= f.label :trust2, @decision_option[4], value: @decision_option[4] %>&nbsp;&nbsp;
    </div>

    <div class="form-group">
      <%= f.label 'Evidence', class: "form-label fw-bold" %>
      <%= f.text_area :evidence2, cols:80, rows: 6, class: "form-control"  %>
    </div>
    <div class="form-group">
      <%= f.label 'Internal Comments', class: "form-label fw-bold" %>
      <%= f.text_area :general_comments2, cols:80, rows: 5, class: "form-control"  %>
    </div>
    <div class="form-group">
      <%= f.label 'Comments to Student', class: "form-label fw-bold" %><br />&nbsp;&nbsp;
      <%= f.radio_button :student_comments2, EpaReview.comments_to_student.first, class: "student_comments2_congrats", class: "student_comments1_congrats", data: { epa_review_form_logic_target: "congrats" }  %>
      <%= f.label :student_comments2, EpaReview.comments_to_student.first, value: EpaReview.comments_to_student.first %><br />&nbsp;&nbsp;
      <%= f.radio_button :student_comments2, EpaReview.comments_to_student.second, class: "student_comments2_making_progress", data: { epa_review_form_logic_target: "makingProgress" }  %>
      <%= f.label :student_comments2, EpaReview.comments_to_student.second, value: EpaReview.comments_to_student.second %><br />&nbsp;&nbsp;
      <%= f.radio_button :student_comments2, EpaReview.comments_to_student.third, class: "student_comments2_work_towards", data: { epa_review_form_logic_target: "workTowards" }  %>
      <%= f.label :student_comments2, EpaReview.comments_to_student.third, value: EpaReview.comments_to_student.third %><br />&nbsp;&nbsp;
      <%= f.radio_button :student_comments2, EpaReview.comments_to_student.last, class: "student_comments2_no_comment" %>
      <%= f.label :student_comments2, EpaReview.comments_to_student.last, value: EpaReview.comments_to_student.last%><br />
    </div>


    <div class="form-actions">
      <%= f.submit "Update Review",
            class: "btn btn-primary",
            data: {
              disable_with: "<i class='fa fa-spinner fa-spin'></i> Updating..."
            } %>
      <%#= f.submit "Save Changes", class: "btn btn-primary center-block", id: "SubmitReview2" %>
    </div>


  </div>
</div>

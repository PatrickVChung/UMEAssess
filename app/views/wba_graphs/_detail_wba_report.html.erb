<br />
<span>
  <h4 style="text-align:center"> WBA Analysis Report
    <%= link_to ('<i class="fa fa-download"></i>').html_safe, download_file_epa_masters_path(file_name: 'wba_report.txt') %>
  </h4>
</span>
<table id="WbaReportTable" class="table table-hover table-striped table-responsive text-center align-middle">
  <thead>
    <tr>
      <th scope="col"></th>
      <% @epas_count.each_key do |epa| %>
        <th scope="col"><%= epa %></th>
      <% end %>
    </tr>
  </thead>
  <tbody>
    <tr>
      <th scope="row" class="text-start">Class Total</th>
      <% @epas_count.each_value do |value| %>
        <td><%= value %></td>
      <% end %>
    </tr>
    <tr>
      <th scope="row" class="text-start">Class Mean</th>
      <% @epas_average.each do |epa| %>
        <% epa.each_value do |value| %>
          <td><%= value %></td>
        <% end %>
      <% end %>
    </tr>
  </tbody>
</table>

<hr>
<div data-controller="datatable">
  <table data-datatable-target="table" id="WbaReportTable" class="table table-hover table-striped responsive" data-sort="true" >
    <thead>
      <tr>
        <th scope="col">Full Name</th>
        <th scope="col">SID</th>
        <th scope="col">Email</th>
        <% hf_epa_header(@permission_group_id).each do |epa| %>
          <th scope="col"><%= epa %></th>
        <% end %>
        <th scope="col">Total WBAs</th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td><%= user.full_name %></td>
          <td><%= user.sid %></td>
          <td><%= user.email %></td>

          <% user_epa_count = user.epas.group(:epa).count %>
          <% user_epa_count = hf_epa_re_order(user_epa_count, @permission_group_id)  #hf_special_sort(user_epa_count) %>

          <% user_epa_count.each_value do |value| %>
            <td class="<%= 'text-warning fw-bold' if value < 2 %> text-center"><%= value %></td>
          <% end %>
          <td class="<%= 'text-danger fw-bold' if user_epa_count.values.sum < 100 %> text-center"><%= user_epa_count.values.sum %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

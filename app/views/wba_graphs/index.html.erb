<%= form_with url: wba_graphs_index_path, method: :get, id: "wba_graph_form", data: { controller: "auto-submit" } do |f| %>
  <div class="row g-3 align-items-center">
    <div class="col-auto">
      <%= f.label :category_id, "Please Select a Category", class: "col-form-label fw-bold" %>
    </div>
    <div class="col-auto">
      <%= f.select :category_id,
            options_for_select(hf_get_categories, selected: params[:category_id]),
            { include_blank: "---" },
            class: "form-select",
            data: { action: "change->auto-submit#submit" } %>
    </div>
  </div>
<% end %>

<hr>
Assessor has the most 4s': <b><%= @most_fours[0] %> </b> (4s: <%= @most_fours[1] %>, total: <%= @total_count_fours %>)
<br />
Assessor has the most 1s': <b><%= @most_ones[0] %> </b> (1s: <%= @most_ones[1] %>, total: <%= @total_count_ones %>)
<% if @selected_category.present? %>
  <div class="card">
      <div class="card-body">
            <% #@categories, @data_series, @selected_category
              if @max_value > 1000
                interval_val = 50
              else
                interval_val = 100
              end
            %>

            <% title = "Workbased Assessment by Clinical Assessors - #{@selected_category}" + "<br/>" +
                       "Total # of WBAs: " + @total_wbas.to_s + "<br />" +
                       "Total # of WBAs for Attending Faculty: " + "<br />" +
                       "<i style='color: tomato'>Requirement: At Least 51 Attendings</i>"

               series_data = [{ name: '1 - I did it', yAxis: 0, data: @data_series[0] },
                              { name: '2 - I talked them through it', yAxis: 0, data: @data_series[1]},
                              { name: '3 - I directed them from time to time', yAxis: 0, data: @data_series[2] },
                              { name: '<b>4 - I was available just in case</b>', yAxis: 0, data: @data_series[3] }
                            ]

             %>

            <div data-controller="highcharts"
                 data-highcharts-series-value="<%= series_data.to_json %>"
                 data-highcharts-categories-value="<%= @categories.to_json %>"
                 data-highcharts-title-value="<%= title %>"
                 data-highcharts-y-title-value="No of WBAs"
                 data-highcharts-y-max-value="<%= @max_value %>"
                 data-highcharts-y-tick-interval-value="<%= interval_val %>"
                 data-highcharts-chart-type-value="column"
                 style="width:100%; height:600px;">
            </div>
      </div>
    </div>
<% end %>

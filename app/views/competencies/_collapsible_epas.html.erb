
<% if !@epa_student_data.empty? %>
    <div class="card w-75 mx-auto">
      <div class="card-header">
        <div class="card-body"><p style="color:purple;font-size:22px;">EPAs/Badges Section</p></div>
        <%#= high_chart("epa_graph", @chart_epa) %>
        <% title = "EPA - #{@selected_user.full_name}"
           series_data = [{name: @selected_user.full_name, data: @epa_student_data},
                          {name: 'Class Mean', data: @epa_class_mean_data, color: "grey"}]

         %>
        <div data-controller="highcharts"
             data-highcharts-series-value="<%= series_data.to_json %>"
             data-highcharts-categories-value="<%= @epa_categories.to_json %>"
             data-highcharts-title-value="<%= title %>"
             data-highcharts-y-title-value="Percentage (%)"
             data-highcharts-chart-type-value="column"
             data-highcharts-color-by-point-value="false"
             style="width:100%; height:400px;">
        </div>
      </div>
    </div>
    <!-- <div class="card card-body">
      <%#= high_chart("epa_new_graph", @chart_epa_new) %>
    </div> -->
    <div class="card w-75 mx-auto">
      <div class="card-body">
        <% for i in 1..13 do %>
          <% epa_code = "epa#{i}" %>
          <% epa = hf_epa_level3_detail(@comp, i.to_s, "3") %>
            <div class="accordion" id="accordionEpaParent">
              <div class="accordion-item">
                <h2 class="accordion-header">
                  <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseEPA<%= i %>" aria-expanded="false" aria-controls="collapseEPA<%= i %>">
                    <div class="labels">
                      <span><h5>EPA<%= i %> - <%= hf_get_epa_desc2("EPA#{i}") %>
                        <% if !@student_badge_info["EPA#{i}"].nil? && hf_ok_to_release_badge(@student_badge_info["EPA#{i}"]["status_date"], @release_date) #current_user.coaching_type != "student" %>
                          [Badge Status:
                          <% if @student_badge_info["EPA#{i}"]["status"] == 'Badge' and !@spec_program_msg.include? "Paused badging" %>
                                <span style="color:purple;"><%=  @student_badge_info["EPA#{i}"]["status"] %></span>]
                                <%= image_tag ("epa/EPA#{i}.png"), size: "20x20" %>
                          <% else %>
                                <span style="color:blue;"> <%= @student_badge_info["EPA#{i}"]["status"] %></span>]
                                <%= image_tag ("epa/EPA#{i}.png"), size: "20x20", class: "opaque-image" %>
                          <% end %>
                        <% else %>
                                <%= image_tag ("epa/EPA#{i}.png"), size: "20x20", class: "opaque-image" %>
                        <% end %></h5>

                        <div id="epa-progress-<%= i %>" class="progress" role="progressbar" aria-label="Gradient progress bar" aria-valuenow="<%= @epa_student[epa_code] %>" aria-valuemin="0" aria-valuemax="100">
                          <div class="progress-bar gradient-red-to-green" style="width: <%= @epa_student[epa_code] %>%;">
                            <span class="px-1"><%= @epa_student[epa_code] %>% QA Completion</span> 
                          </div>
                        </div>

                      </span>
                    </div>
                  </button>
                </h2>
                <div id="collapseEPA<%= i %>" class="accordion-collapse collapse" data-bs-parent="#accordionEpaParent">
                  <div class="accordion-body">
                    <%= render partial: "competencies/detail_badge_display", locals: {i: i, epa: epa} %>
                    <%= render partial: "competencies/epa_assessors", locals: {:i => i, :epa => epa, :assessors => hf_epa_asessors} %>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        <% else %>
          <br />
          <h5 style="color:orange;"> No EPA/Competencies Data FOUND! </h5>
          <hr>
        <% end %>
      </div>
    </div>

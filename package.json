{
  "name": "app",
  "private": true,
  "devDependencies": {
    "esbuild": "^0.27.2"
  },
  "scripts": {
      "build": "node esbuild.config.mjs",
      "build:css:compile": "sass ./app/assets/stylesheets/app.bootstrap.scss:./app/assets/builds/application.css --no-source-map --load-path=node_modules --load-path=node_modules/bootstrap/scss --load-path=node_modules/bootstrap-icons/font --quiet-deps",
      "build:css:prefix": "postcss ./app/assets/builds/application.css --use=autoprefixer --output=./app/assets/builds/application.css",
      "build:css": "yarn build:css:compile && yarn build:css:prefix",
      "watch:css": "nodemon --watch ./app/assets/stylesheets/ --ext scss,css --exec \"yarn build:css\""
    },
  "dependencies": {
    "@fullcalendar/bootstrap5": "^6.1.20",
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo-rails": "^8.0.21",
    "@popperjs/core": "^2.11.8",
    "autoprefixer": "^10.4.23",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "datatables.net": "^2.3.6",
    "datatables.net-bs5": "^2.3.6",
    "esbuild-coffeescript": "^3.1.0",
    "flatpickr": "^4.6.13",
    "highcharts": "^12.5.0",
    "jquery": "^4.0.0",
    "jquery-contextmenu": "^2.10.1",
    "jquery-ui-dist": "^1.13.3",
    "nodemon": "^3.1.11",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "sass": "^1.97.3",
    "tom-select": "^2.5.2"
  },
  "browserslist": [
    "defaults"
  ]
}
